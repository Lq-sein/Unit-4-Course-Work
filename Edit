import time
start = time.time()

# Load data from file
def load_data(filename):
    vendors = []

    with open(filename, "r") as file:
        for line in file:
            parts = line.strip().split(",")

            vendor = {
                "id": parts[0],
                "name": parts[1],
                "year_week": parts[2],
                "vegan": int(parts[3]),
                "meat": int(parts[4]),
                "onions": float(parts[5]),
                "ketchup": float(parts[6])
            }

            vendors.append(vendor)

    return vendors

# Validation (checking if the results are false)
import re
def validate_vendor(v):

#1. Vendor ID: Two uppercase letters, underscore, three digits (e.g., AB_123)
    if not re.match(r"^[A-Z]{2}_\d{3}$" , v["id"]):
        return False, "Invalid Vendor ID: " + str(v["id"])

#2. Vendor Name: 2 to 25 characters long
    name_length = len(v["name"])
    if name_length < 2 or name_length > 25:
        return False, "Invalid Name Length: " + str(v["name"])

#3. Year and Week: yyyww, WW between 1 and 52
    if len(v["year_week"]) != 6 or not v["year_week"].isdigit():
        return False, "Invalid Year_Week format: " + str(v["year_week"])
# Get the last two digits for the week
    week = int(v["year_week"][4:])
    if week < 1 or week > 52:
        return False, "Week out of range: " + str (week)

# 4 & 5. Hotdogs: Must be divisible by 10
    if v["vegan"] % 10 != 0:
        return False, "Vegan hotdogs not divisible by 10"
    if v["meat"] %10 != 0:
        return False, "Meat hotdogs not divisible by 10"

#6. Onions: Decimal in 0.5kg increments
    if (v["onions"] * 2) % 1 != 0:
        return False, "Onions not in 0.5kg increments"

#7. Ketchup: Integer between 1 and 4
    if v["ketchup"] < 1 or v["ketchup"] > 4 or v ["ketchup"] % 1 != 0:
        return False, "Ketchup must be integer 1-4"

    return True, ""

# Linear search (check each item one by one)
def linear_search_unsorted(data, target_name):
    for vendor in data:
        if vendor["name"] == target_name:
            return vendor
    return None

def linear_search_sorted(data, target_name):
    for vendor in data:
        if vendor["name"] == target_name:
            return vendor
    return None

# Binary search (data must be sorted first)
def binary_search(data, target_name):
    low = 0
    high = len(data) - 1

    while low <= high:
        mid = (low + high) // 2

        if data[mid]["name"] == target_name:
            return data[mid]
        elif data[mid]["name"] < target_name:
            low = mid + 1
        else:
            high = mid - 1

    return None

# Bubble sort (simple sorting method)
def bubble_sort(data):
    n = len(data)

    for i in range(n):
        for j in range(0, n - i - 1):
            if data[j]["name"] > data[j + 1]["name"]:
                temp = data[j]
                data[j] = data[j + 1]
                data[j + 1] = temp

    return data

# Quick sort (faster sorting)
def quick_sort(data):
    if len(data) <= 1:
        return data

    pivot = data[0]
    left = []
    right = []

    for item in data[1:]:
        if item["name"] <= pivot["name"]:
            left.append(item)
        else:
            right.append(item)

    return quick_sort(left) + [pivot] + quick_sort(right)

# Measure how long a function takes
def measure_time(function, *args):
    start = time.perf_counter()
    result = function(*args)
    end = time.perf_counter()

    # Calculate the elsaped time and round it to 8 decimal places

    elapsed_time = round(end - start, 8)

    print(function.__name__, "time:", elapsed_time)

    return result


# Find vendor with most total sales
def most_productive_vendor(data):
    totals = {}

    for v in data:
        name = v["name"]

        if name not in totals:
            totals[name] = 0

        totals[name] = totals[name] + v["vegan"] + v["meat"]

    return max(totals, key = totals.get)


# Count total vegan and meat hotdogs
def vegan_vs_meat(data):
    vegan_total = 0
    meat_total = 0

    for v in data:
        vegan_total += v["vegan"]
        meat_total += v["meat"]

    return vegan_total, meat_total


# Find the smallest ketchup value
def least_ketchup(data):
    smallest = data[0]

    for v in data:
        if v["ketchup"] < smallest["ketchup"]:
            smallest = v

    return smallest


# Save results to a file
def save_results(filename, results):
    file = open(filename, "w")
    file.write(results)
    file.close()


